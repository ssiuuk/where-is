# Public host name of the server, pointing at your router's public IP.
# Caddy gets a Let's Encrypt certificate for it automatically.
WHEREIS_DOMAIN=whereis.example.com

# Google sign-in (optional). Create an OAuth client of type "Web application"
# in Google Cloud console and add this redirect URI:
#   https://whereis.example.com/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SHA-256 fingerprint(s) of the key that signs the Android app, so links on
# QR labels open the app directly. Comma separated. See README.
ANDROID_CERT_SHA256=

# The address people use to reach the server. Links in emails use it.
# Defaults to https://$WHEREIS_DOMAIN; set it when another proxy (such as
# Traefik) serves the site.
# PUBLIC_URL=https://whereis.example.com

# Email server for "Forgot password?" emails (optional). Leave SMTP_HOST empty
# to set it in the dashboard instead (Settings > Mail settings).
SMTP_HOST=
# 587 uses STARTTLS; 465 uses TLS from the start (SMTP_TLS defaults to true for 465)
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_TLS=false
# The address and name emails come from. Required when SMTP_HOST is set.
MAIL_FROM_ADDRESS=whereis@example.com
MAIL_FROM_NAME=Where Is

# Site admins: people who sign in with one of these emails (comma separated)
# get the server tools in Settings > Admin: accounts, sign-up, email, Google
# sign-in and backups. The email must be verified: sign in with Google, or
# confirm it from the email the server sends. Whoever creates a household is
# its family admin, with that household's tools.
ADMIN_EMAILS=

# New accounts. Leave this unset to switch sign-up on and off in
# Settings > Admin. Setting it here (true or false) fixes it and greys out
# the switch. Existing accounts (email or Google) still sign in either way.
# ALLOW_SIGNUP=false

# Optional overrides
# ANDROID_PACKAGE=com.ssiuuk.whereis
# APP_DOWNLOAD_URL=https://github.com/ssiuuk/where-is/releases/tag/android-latest
# WHEREIS_IMAGE=ghcr.io/ssiuuk/where-is-server:latest
